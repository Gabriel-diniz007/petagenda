<%- include('../partials/header', { titulo: 'Serviços' }) %>

<div class="titulo-secao">
  <h1>Serviços</h1>
  <a href="/servicos/novo" class="botao">+ Novo serviço</a>
</div>

<% if (servicos.length === 0) { %>
  <p class="vazio">Nenhum serviço cadastrado.</p>
<% } else { %>
  <div class="tabela-wrap">
  <table>
    <thead><tr><th>Serviço</th><th>Descrição</th><th>Duração</th><th>Preço</th><th>Ações</th></tr></thead>
    <tbody>
    <% servicos.forEach(function (s) { %>
      <tr>
        <td><%= s.nome %></td>
        <td><%= s.descricao || '-' %></td>
        <td><%= s.duracaoMin %> min</td>
        <td><%= moeda(s.preco) %></td>
        <td class="acoes">
          <a href="/servicos/<%= s.id %>/editar" class="botao pequeno cinza">Editar</a>
          <form method="post" action="/servicos/<%= s.id %>/excluir" onsubmit="return confirm('Excluir este serviço?')">
            <button class="botao pequeno vermelho">Excluir</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
